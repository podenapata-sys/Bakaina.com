rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // An admin is any signed-in user with a document at admins/{uid}.
    // Create that document by hand in the Firebase console (see docs/FIREBASE_SETUP.md).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only product data such as the buying price. Never public.
    match /productPrivate/{id} {
      allow read, write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{id} {
      // Shoppers may place a new cash-on-delivery order but never read or change orders.
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50;
      allow read, update, delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
